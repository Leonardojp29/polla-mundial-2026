# Copia este archivo a .env.local y completa los valores.
# En desarrollo local, los valores salen de `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token de football-data.org (gratis, https://www.football-data.org/client/register).
# Lo usan scripts/sync-results.mjs y /api/cron/sync para traer resultados.
FOOTBALL_DATA_API_TOKEN=

# Secreto que protege /api/cron/sync (genera uno: openssl rand -hex 24).
# En producción va como variable de entorno en Vercel y como header
# "Authorization: Bearer <valor>" en el cron externo (cron-job.org).
CRON_SECRET=

# Web Push / recordatorios (genera el par: npx web-push generate-vapid-keys).
# Ambas van también en Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Correos (separados por coma) que se promueven a ADMIN automáticamente al
# iniciar sesión. Alternativa: node scripts/make-admin.mjs <correo>.
ADMIN_EMAILS=

# Login con Google (opcional). Crea las credenciales OAuth en Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Estas dos las lee `supabase start` desde el entorno (expórtalas antes de arrancar):
#   export SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
#   export SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="GOCSPX-xxxx"
