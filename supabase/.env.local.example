# Credenciales de Google OAuth (copia este archivo como supabase/.env.local y pega tus valores).
# Se crean en: https://console.cloud.google.com/apis/credentials
# supabase/.env.local está ignorado por git: tus secretos no se suben.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxx
