{
  "name": "polla-mundial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pm2-server-dev": "pm2 start npm --name \"lapollalibero-dev-glr\" -- run dev",
    "pm2-server-prod": "next build && pm2 start npm --name \"lapollalibero-prod-glr\" -- start",
    "lint": "eslint",
    "db:restart": "bash scripts/restart-supabase.sh",
    "db:seed": "node scripts/seed.mjs",
    "sync": "node scripts/sync-results.mjs",
    "sync:dry": "node scripts/sync-results.mjs --dry",
    "sync:watch": "node scripts/sync-results.mjs --watch",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "next": "16.2.7",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
